# Copia este archivo como .env y ajusta los valores.

# Cadena de conexión a PostgreSQL: postgresql://usuario:password@host:puerto/basededatos
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agromarket?schema=public"

# Puerto donde corre la API
PORT=3000

# Secreto para firmar los JWT (usa un valor largo y aleatorio en producción)
JWT_SECRET="cambia-este-valor-por-uno-seguro"

# Tiempo de expiración del token
JWT_EXPIRES_IN="7d"

# Origen(es) permitidos por CORS, separados por coma
CORS_ORIGIN="http://localhost:4200,http://localhost:8100"
=======
# Cadena de conexión a PostgreSQL (Neon, Supabase, Docker o instalación local).
# Ejemplo con Neon: postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/agromarket?sslmode=require
DATABASE_URL="postgresql://usuario:password@localhost:5432/agromarket"

# Puerto en el que corre la API.
PORT=3000

# Secreto para firmar los JWT. Genera uno propio y no lo compartas ni lo subas a git.
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"

# Tiempo de vida del token de sesión.
JWT_EXPIRES_IN="7d"

# Origen permitido para CORS (la URL donde corre el frontend Ionic/Angular).
CORS_ORIGIN="http://localhost:8100"
